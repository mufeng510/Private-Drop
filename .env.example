# Private Drop 部署环境变量（仅部署必需项；业务配置请登录管理界面设置）
# 复制为 .env 后按需修改：cp .env.example .env

# 宿主机对外访问的端口；容器内固定监听 8080。
# 默认 http://<NAS 局域网 IP>:8088
PORT=8088

# 容器内数据目录。compose 固定把宿主机 ./data 挂载到此处，
# 通常无需修改；务必保证宿主机 ./data 对 UID 10001 可写。
DATA_DIR=/data

# 时区，影响日志时间的显示（IANA 时区名，例如 Asia/Shanghai、UTC）。
TZ=Asia/Shanghai

# 以下为可选项，一般不用改：
# 使用 GHCR 已发布镜像时取消注释并填写：
# IMAGE=ghcr.io/OWNER/private-drop:latest
# 本地构建时写入镜像版本号（发布流水线会自动传入 git 标签/commit）：
# VERSION=dev
# 公网经 Cloudflare Tunnel / 反向代理访问时，必须把代理的源 IP 段填在这里，
# 应用才会信任 X-Forwarded-For / CF-Connecting-IP 并正确识别公网客户端。
# 未配置时，带代理头且来自非受信代理的“初始化”请求会被拒绝（fail closed）。
# 例：TRUSTED_PROXY_CIDRS=127.0.0.0/8,172.16.0.0/12
# TRUSTED_PROXY_CIDRS=
